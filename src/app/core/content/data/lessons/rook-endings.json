          },
          {
            "kind": "term",
            "id": "passed-pawn",
            "text": "passed pawn"
          },
          {
            "kind": "text",
            "text": ", yours or the rival’s. Behind your pawn, the rook pushes it and gains room with every step; in front of it, the rook gets shut in. Here the rook on "
          },
          {
            "kind": "square",
            "square": "a1"
          },
          {
            "kind": "text",
            "text": " stands behind the pawn on "
          },
          {
            "kind": "square",
            "square": "a5"
          },
          {
            "kind": "text",
            "text": "."
          }
        ]
      },
