  "steps": [
    {
      "kind": "explain",
      "text": {
        "es": [
          {
            "kind": "text",
            "text": "Un "
          },
          {
            "kind": "term",
            "id": "passed-pawn",
            "text": "peón pasado"
          },
          {
            "kind": "text",
            "text": " no tiene delante ningún peón rival, ni en su columna ni en las de al lado: nada lo frena salvo las piezas. Cada paso que da lo acerca a la "
          },
          {
            "kind": "term",
            "id": "promotion",
            "text": "coronación"
          },
          {
            "kind": "text",
            "text": ", así que hay que vigilarlo siempre, sea tuyo o del rival. Aquí el peón de "
          },
          {
            "kind": "square",
            "square": "b5"
          },
          {
            "kind": "text",
            "text": " es pasado."
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "A "
          },
          {
            "kind": "term",
            "id": "passed-pawn",
            "text": "passed pawn"
          },
          {
            "kind": "text",
            "text": " has no rival pawn in front of it, on its own file or on the ones next to it: only pieces can stop it. Every step brings it closer to "
          },
          {
            "kind": "term",
            "id": "promotion",
            "text": "promotion"
          },
          {
            "kind": "text",
            "text": ", so it must always be watched, whether it is yours or the rival’s. Here the pawn on "
          },
          {
            "kind": "square",
            "square": "b5"
          },
          {
            "kind": "text",
            "text": " is passed."
          }
        ]
      },
      "board": {
        "fen": "6k1/5ppp/8/1P6/8/8/5PPP/6K1 w - - 0 1",
        "orientation": "white",
        "highlights": [
          "b5"
        ]
      }
    },
    {
      "kind": "explain",
      "text": {
        "es": [
          {
            "kind": "text",
            "text": "Un peón pasado se crea con una "
          },
          {
            "kind": "term",
            "id": "pawn-majority",
            "text": "mayoría de peones"
          },
          {
            "kind": "text",
            "text": ": más peones que el rival en un "
          },
          {
            "kind": "term",
            "id": "flank",
            "text": "flanco"
          },
          {
            "kind": "text",
            "text": ". Aquí las blancas tienen tres contra dos en el flanco de dama. Avanzan juntos, se cambian y al final queda uno sin rival delante."
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "A passed pawn is made with a "
          },
          {
            "kind": "term",
            "id": "pawn-majority",
            "text": "pawn majority"
          },
          {
            "kind": "text",
            "text": ": more pawns than the rival on one "
          },
          {
            "kind": "term",
            "id": "flank",
            "text": "flank"
          },
          {
            "kind": "text",
            "text": ". Here White has three against two on the queenside. They advance together, trade off, and in the end one is left with no rival in front of it."
          }
        ]
      },
      "board": {
        "fen": "6k1/pp3ppp/8/8/8/8/PPP2PP1/6K1 w - - 0 1",
