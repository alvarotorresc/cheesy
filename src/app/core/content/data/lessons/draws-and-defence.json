  "summary": {
    "es": "Jaque perpetuo, triple repetición y ahogado: cómo empatar una partida que ibas perdiendo.",
    "en": "Perpetual check, threefold repetition and stalemate: how to draw a game you were losing."
  },
  "terms": [
    "perpetual-check",
    "threefold-repetition"
  ],
  "sources": [
