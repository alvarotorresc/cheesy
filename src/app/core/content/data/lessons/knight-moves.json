        ],
        "en": [
          {
            "kind": "text",
            "text": "Summary: the knight jumps in an L, two squares and one, over whatever is in between. It always changes square colour, and it has more jumps in the centre than on the edge. Each side starts with two, between the rooks and the bishops: the marked ones."
          }
        ]
