  "steps": [
    {
      "kind": "explain",
      "text": {
        "es": [
          {
            "kind": "text",
            "text": "El alfil se mueve en "
          },
          {
            "kind": "term",
            "id": "diagonal",
            "text": "diagonal"
          },
          {
            "kind": "text",
            "text": ", hacia delante o hacia atrás, tantas casillas como quiera. Como la torre, no puede saltar. Desde "
          },
          {
            "kind": "square",
            "square": "d4"
          },
          {
            "kind": "text",
            "text": " llega a cualquier casilla de las flechas."
          }
        ],
        "en": [
          {
            "kind": "text",
            "text": "The bishop moves along a "
          },
          {
            "kind": "term",
            "id": "diagonal",
            "text": "diagonal"
          },
          {
            "kind": "text",
            "text": ", forwards or backwards, as many squares as it likes. Like the rook, it cannot jump. From "
          },
          {
            "kind": "square",
            "square": "d4"
          },
          {
            "kind": "text",
            "text": " it can reach any square along the arrows."
          }
        ]
      },
