{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cheesy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "cheesy.alvarotc.com", "custom_domain": true }],
  "assets": {
    "directory": "../dist/cheesy/browser",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
}
